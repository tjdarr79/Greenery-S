# Copy this file to farm-bridge.env in the SAME FOLDER as farm_bridge.py.
# The script loads it automatically - no manual environment variables needed.
# Never commit farm-bridge.env with real credentials to a public repo.

# --- Required: your MQTT broker (usually your Home Assistant instance) ---
FARM_MQTT_HOST=192.168.X.X
FARM_MQTT_USER=your_mqtt_username
FARM_MQTT_PASS=your_mqtt_password

# --- Farm name: set BEFORE the first run --------------------------------
# Names the Home Assistant device and decides every entity ID
# ("Smith Farm" -> sensor.smith_farm_cultivation_ph). Unset means
# "Greenery S Farm", the name every install had before this existed.
# Any other name: render the automations/dashboards with
# tools/render-farm-yaml.py - see greenery-bridge/DOCS.md, "Farm name".
# FARM_NAME=Greenery S Farm

# --- Optional: only change if your farm's local IP differs from default ---
# FARM_SSE_URL=http://192.168.200.200:3001/farm-data

# --- Task Mode control (optional) ---------------------------------------
# Endpoint the Enter/Exit Task Mode buttons POST to. Defaults below match a
# stock Greenery S; override only if the farm's IP changes or a farmhand
# update moves the route.
# FARM_CONTROL_URL=http://192.168.200.200:3001/farm-control
# FARM_CONTROL_TRANSPORT=http

# --- farmhand reply stream -----------------------------------------------
# The bridge always reads /farm-monitoring, where farmhand's real replies
# arrive. The URL follows FARM_SSE_URL; override only if it moves.
# FARM_MONITORING_URL=http://192.168.200.200:3001/farm-monitoring
# Investigation only: log its first 20 events after start. Leave unset normally.
# FARM_LOG_MONITORING=1

# --- Dosing tank level sensors (module E831CDC7E680) ----------------------
# Defaults shown. The three per-tank lists take a JSON list or a comma-
# separated one, in farmhand's order. Names decide entity IDs at first sight -
# set them before the first run. See greenery-bridge/DOCS.md, "Dosing tank levels".
# FARM_DOSING_TANK_NAMES=Nutrient A, Nutrient B, pH Down, Boost / pH Up
# FARM_DOSING_TANK_INPUTS=digital_1, digital_2, digital_3, digital_4
# FARM_DOSING_TANKS_ENABLED=true, true, true, true
# FARM_DOSING_LEVEL_LOW_VALUE=1
# FARM_DOSING_LEVEL_WINDOW_S=600
# FARM_DOSING_SENSOR_FAULT_CHANGES_PER_HOUR=20
# FARM_DOSING_SILENT_DAYS=21
