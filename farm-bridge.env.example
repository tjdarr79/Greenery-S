# Copy this file to farm-bridge.env in the SAME FOLDER as farm_bridge.py.
# The script loads it automatically - no manual environment variables needed.
# Never commit farm-bridge.env with real credentials to a public repo.

# --- Required: your MQTT broker (usually your Home Assistant instance) ---
FARM_MQTT_HOST=192.168.X.X
FARM_MQTT_USER=your_mqtt_username
FARM_MQTT_PASS=your_mqtt_password

# --- Optional: only change if your farm's local IP differs from default ---
# FARM_SSE_URL=http://192.168.200.200:3001/farm-data
